---
import { getT, homeHref, aboutHref, isAbout } from "../i18n.js";
const T = getT(Astro), t = T.footer;
// section links lead back to the home page from the About page; Contact is on both pages
const home = isAbout(Astro) ? homeHref(T.lang) : "";
const hrefs = [home || "#", aboutHref(T.lang), `${home}#services`, `${home}#pricing`, `${home}#faq`, "#contact"];
const social = [
