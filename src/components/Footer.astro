  ["Facebook", "https://www.facebook.com/cairocreatives1", "M13.5 21v-7.700h2.600l.4-3h-3V8.400c0-.87.24-1.460 1.500-1.460h1.600V4.250A21 21 0 0 0 14.300 4.100c-2.300 0-3.900 1.400-3.900 4v2.200H7.800v3h2.600V21h3.100Z"],
  ["WhatsApp", "https://wa.me/201100379960", "M12 3a8.5 8.5 0 1 1 0 17a8.5 8.5 0 1 1 0-17ZM12 4.7a6.8 6.8 0 1 0 0 13.6a6.8 6.8 0 1 0 0-13.6ZM5.3 15.8L3.3 21.3L9 19.6ZM9.6 8.2c.2-.2.5-.2.7 0l.9 1.3c.1.2.1.5-.1.7l-.5.5c.4.9 1.1 1.6 2 2l.5-.5c.2-.2.5-.2.7-.1l1.3.9c.2.2.2.5 0 .7l-.6.7c-.3.3-.8.4-1.2.3-2-.6-3.6-2.2-4.2-4.2-.1-.4 0-.9.3-1.2Z"],
