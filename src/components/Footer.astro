---
import { getT } from "../i18n.js";
const t = getT(Astro).footer;
const hrefs = ["#", "#intro", "#services", "#pricing", "#faq", "#contact"];
---
<footer>
  <div class="bg"></div>
  <div class="fcols">
    <p>{t.line}</p>
    <div class="nav"><h6>{t.nav}</h6>{t.links.map((label, i) => <a href={hrefs[i]}>{label}</a>)}</div>
    <div class="soc"><h6>{t.connect}</h6><a href="#">LinkedIn</a><a href="#">Instagram</a><a href="#">YouTube</a></div>
  </div>
  <div class="wordmark" lang="en" dir="ltr">Cairo Creatives</div>
</footer>
