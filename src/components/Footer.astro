---
<footer>
  <div class="bg"></div>
  <div class="fcols">
    <p class="motto">{t.line[0]}<br><span>{t.line[1]}</span></p>
    <div class="nav"><h6>{t.nav}</h6><ul>{t.links.map((label, i) => <li><a href={hrefs[i]}><sup>{String(i + 1).padStart(2, "0")}</sup>{label}</a></li>)}</ul></div>
    <div class="soc"><h6>{t.connect}</h6><div class="icons">{social.map(([name, href, d]) => <a href={href} target="_blank" rel="noopener" aria-label={name}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={d} /></svg></a>)}</div></div>
  </div>
  <div class="wordmark" lang="en" dir="ltr">Cairo Creatives</div>
</footer>
