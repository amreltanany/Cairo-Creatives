---
import { getT, homeHref } from "../i18n.js";
const t = getT(Astro);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const hrefs = ["#", "#intro", "#services", "#pricing", "#faq"];
const other = { href: homeHref(t.lang === "ar" ? "en" : "ar"), lang: t.lang === "ar" ? "en" : "ar" };
---
<nav>
  <a href="#" class="logo" aria-label={`Cairo Creatives ${t.nav.home}`}><img src={`${base}/logo.svg`} alt=""><span>Cairo Creatives</span></a>
  <div class="links">
    {t.nav.links.map((label, i) => <a href={hrefs[i]}><span class="roll"><span data-t={label}>{label}</span></span><sup>{String(i + 1).padStart(2, "0")}</sup></a>)}
    <a href={other.href} class="lang-switch" hreflang={other.lang} lang={other.lang} aria-label={t.nav.otherLabel}>{t.nav.other}</a>
    <a href="#contact" class="btn"><span class="roll"><span data-t={t.nav.contact}>{t.nav.contact}</span></span></a>
  </div>
  <button class="burger" aria-label={t.nav.open} data-open={t.nav.open} data-close={t.nav.close} aria-expanded="false" aria-controls="menu"></button>
</nav>
<div class="menu" id="menu" aria-hidden="true">
  {t.nav.links.map((label, i) => <a href={hrefs[i]}>{label}</a>)}<a href="#contact">{t.nav.contact}</a>
  <a href={other.href} class="lang-switch" hreflang={other.lang} lang={other.lang}>{t.nav.other}</a>
</div>
