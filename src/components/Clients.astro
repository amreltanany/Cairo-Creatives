---
import { getT } from "../i18n.js";
const t = getT(Astro).clients;
// title={false} where the page already has its own heading (About)
const { title = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// past clients' logos as [name, file in public/images/clients]; not links, the name shows on hover.
// The Behance ones were cut out of our post designs (no logo files there) and turned white for the navy row.
const logos = [
  ["Qaro2a", "qaro2a.png"],
  ["Display Egypt Advertising", "display-egypt.png"],
  ["Talha Real Estate", "talha.png"],
  ["Deutsch Elite", "deutsch-elite.png"],
  ["Sehetak Centre", "sehetak.png"],
  ["Al Masar Al Arabi", "al-masar.png"],
  ["G-Class Limousine", "g-class.png"],
  ["Abd Elaty Pharmacy", "abd-elaty.png"],
  ["Consul Tourism", "consul-tourism.png"],
  ["Home Care", "home-care.png"],
  ["Amr Eltanany", "a-mark.svg"],
  ["El-Wahab Center", "el-wahab.png"],
  ["Al Aziz Shipping", "al-aziz.png"],
  ["Ebtkar", "ebtkar.png"],
  ["RUVR", "ruvr.png"],
  ["Serag Restaurant", "serag.png"],
  ["Business Hub Academy", "business-hub.png"],
  ["Dr. Ahmed Hodieb", "dr-ahmed-hodieb.png"],
  ["EduGate", "edugate.png"],
  ["Iqra Wa Irtaqi", "iqra-wartaqi.png"],
];
---
<div class="clients">
  {title && <p class="tag">{t.title}</p>}
  <!-- the row is doubled so the loop is seamless; the copy is hidden from screen readers.
       The loop time grows with the number of logos so the speed stays slow and steady. -->
  <div class="marquee" dir="ltr" style={`--n:${logos.length}`}>
    {[0, 1].map((copy) => (
      <ul aria-hidden={copy ? "true" : undefined}>
        {logos.map(([name, file]) => <li data-name={name}><img src={`${base}/images/clients/${file}`} alt={copy ? "" : name} /></li>)}
      </ul>
    ))}
  </div>
</div>
