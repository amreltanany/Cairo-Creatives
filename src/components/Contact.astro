---
import { getT } from "../i18n.js";
const t = getT(Astro).contact;
// WhatsApp: 01100379960 in international form (Egypt +20, leading 0 dropped); the message is prefilled in the page's language
const whatsapp = `https://wa.me/201100379960?text=${encodeURIComponent(t.message)}`;
---
<section class="contact" id="contact">
  <div class="cbox rv">
    <h3>{t.title[0]}<br>{t.title[1]}</h3>
    <p>{t.text}</p>
    <a class="wa" href={whatsapp} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.600 15.100L2 22l5-1.300A10 10 0 1 0 12 2Zm0 18.200a8.200 8.200 0 0 1-4.200-1.150l-.3-.18-3 .8.8-2.900-.2-.3A8.200 8.200 0 1 1 12 20.200Zm4.500-6.100c-.25-.12-1.450-.72-1.680-.8-.22-.08-.38-.12-.55.12-.16.25-.63.8-.77.96-.14.17-.28.19-.53.06-.25-.12-1.040-.38-1.980-1.220-.73-.65-1.230-1.460-1.370-1.700-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.55-1.330-.76-1.820-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.050 0 1.200.88 2.370 1 2.540.12.16 1.730 2.640 4.200 3.700.59.25 1.050.4 1.400.52.59.19 1.130.16 1.550.1.47-.07 1.450-.6 1.660-1.170.2-.57.2-1.060.14-1.170-.06-.1-.22-.16-.47-.29Z"/></svg>
      {t.button}
    </a>
  </div>
</section>
