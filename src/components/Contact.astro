<section class="contact" id="contact">
  <form class="rv" id="contactForm">
    <h3>Tell us about<br>your project</h3>
    <label>Name<input type="text" name="name" required></label>
    <label>Email<input type="email" name="email" required></label>
    <label>Company<input type="text" name="company"></label>
    <label class="check"><input type="checkbox" name="optin"> Send me occasional updates</label>
    <button class="btn dark" type="submit">Submit</button>
    <p id="formMsg" role="status" aria-live="polite" style="font:500 14px var(--body);color:rgba(0,0,0,.6)"></p>
  </form>
</section>
