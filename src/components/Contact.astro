---
import { getT } from "../i18n.js";
const t = getT(Astro).contact;
---
<section class="contact" id="contact">
  <form class="rv" id="contactForm" data-sending={t.sending} data-sent={t.sent} data-thanks={t.thanks}>
    <h3>{t.title[0]}<br>{t.title[1]}</h3>
    <label>{t.name}<input type="text" name="name" required></label>
    <label>{t.email}<input type="email" name="email" required></label>
    <label>{t.company}<input type="text" name="company"></label>
    <label class="check"><input type="checkbox" name="optin"> {t.optin}</label>
    <button class="btn dark" type="submit">{t.submit}</button>
    <p id="formMsg" role="status" aria-live="polite" style="font:500 14px var(--body);color:rgba(0,0,0,.6)"></p>
  </form>
</section>
